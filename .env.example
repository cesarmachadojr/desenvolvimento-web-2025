# .env.example
# Este arquivo lista TODAS as variáveis esperadas pelo projeto.
# Em produção (Render), as variáveis com valores REAIS são configuradas no painel.

# ==================================
# 1. Configurações de Banco de Dados
# ==================================

# VARIÁVEL DE PRODUÇÃO (Prioritária no db.js):
# Esta é a URL de conexão COMPLETA fornecida pelo Render após a criação do DB.
DATABASE_URL="postgres://user:password@host:port/database" 

# VARIÁVEIS DE DESENVOLVIMENTO LOCAL (Usadas como fallback se DATABASE_URL não for setada):
PGHOST=localhost
PGPORT=5432
PGDATABASE=node_tasks_db
PGUSER=postgres
PGPASSWORD=sua_senha_do_postgres

# ==================================
# 2. Configurações do Servidor
# ==================================
# PORTA: O Render fornece a porta, este valor é para o ambiente local.
PORT=3000

# Variável de segurança crucial para a sessão. 
# Deve ser uma string longa e aleatória e ser configurada no Render.
SESSION_SECRET=chave_secreta_para_a_sessao