<header class="bg-blue-600 text-white px-6 py-4 shadow-md">
  <nav class="max-w-7xl mx-auto flex items-center justify-between flex-wrap">

    <!-- Logo -->
    <a href="/" class="text-2xl font-extrabold tracking-tight">
      Praias Brasil
    </a>

    <!-- Botão do menu (mobile) -->
    <input type="checkbox" id="menu-toggle" class="hidden" />
    <label for="menu-toggle" class="cursor-pointer md:hidden block">
      <svg class="fill-current text-white w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
        <path d="M4 5h16M4 12h16M4 19h16" />
      </svg>
    </label>

    <!-- MENU -->
    <ul class="w-full md:flex md:w-auto md:items-center md:gap-6 mt-4 md:mt-0 hidden md:block" id="menu">

      <!-- Início -->
      <li>
        <a href="/praias" class="block px-2 py-1 hover:underline">
          Início
        </a>
      </li>

      <!-- Cadastrar Praia -->
      <li>
        <a href="/praias/nova" class="block px-2 py-1 hover:underline">
          Cadastrar Praia
        </a>
      </li>

      <!-- Cadastrar Usuário -->
      <li>
        <a href="/" class="block px-2 py-1 hover:underline">
          Sair
        </a>
      </li>

      <% if (!usuarioLogado) { %>

        <!-- Login -->
        <li>
          <a href="/login" class="block px-2 py-1 hover:underline">
            Login
          </a>
        </li>

        <!-- Perfil -->
        <li>
          <a href="/perfil" class="block px-2 py-1 hover:underline">
            Perfil
          </a>
        </li>

        <!-- Logout -->
        <li>
          <a href="/login" class="block px-2 py-1 hover:underline text-red-300">
            Sair
          </a>
        </li>

      <% } %>

    </ul>

  </nav>

  <style>
    /* Toggle menu mobile */
    #menu-toggle:checked + label + #menu {
      display: block;
    }
  </style>
</header>
