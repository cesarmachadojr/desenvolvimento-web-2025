<div class="container mx-auto p-4">
    <h1 class="text-3xl font-bold mb-6 text-center text-blue-800">Explore Nossas Praias</h1>

    <!-- Exibe mensagens de Sucesso ou Erro (Passadas pelo server.js via session) -->
    <% if (typeof successMessage !== 'undefined' && successMessage) { %>
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4" role="alert">
            <span class="block sm:inline"><%= successMessage %></span>
        </div>
    <% } %>
    <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
            <span class="block sm:inline"><%= errorMessage %></span>
        </div>
    <% } %>

    <div class="flex justify-end mb-4">
        <a href="/praias/nova" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded shadow-lg transition duration-300">
            + Cadastrar Nova Praia
        </a>
    </div>

    <!-- Container da Lista de Praias -->
    <% if (praias && praias.length > 0) { %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <% praias.forEach(function(praia) { %>
                <div class="bg-white rounded-xl shadow-lg hover:shadow-xl transition duration-300 overflow-hidden border border-gray-100">
                    <img src="<%= praia.foto_url || 'https://placehold.co/600x400/226d9c/ffffff?text=Sem+Foto' %>" 
                         alt="Foto da <%= praia.nome %>" 
                         class="w-full h-48 object-cover" 
                         onerror="this.onerror=null;this.src='https://placehold.co/600x400/226d9c/ffffff?text=Sem+Foto';"
                    >
                    <div class="p-5">
                        <h2 class="text-xl font-semibold text-gray-900 mb-2">
                            <!-- Link para a tela de Detalhes da Praia (próximo passo) -->
                            <a href="/praias/<%= praia.id_praia %>" class="hover:text-blue-600 transition duration-150">
                                <%= praia.nome %>
                            </a>
                        </h2>
                        <p class="text-sm text-gray-500 mb-3">
                            <%= praia.cidade %> - <%= praia.estado %>
                        </p>
                        
                        <!-- Exibição da Avaliação -->
                        <div class="flex items-center mb-3">
                            <span class="text-yellow-500 text-lg mr-2">
                                ★
                            </span>
                            <span class="font-bold text-gray-800">
                                <%= praia.media_avaliacao %>
                            </span>
                            <span class="text-sm text-gray-500 ml-1">
                                (Média)
                            </span>
                        </div>

                        <p class="text-gray-600 text-sm overflow-hidden text-ellipsis h-10">
                            <%= praia.descricao.substring(0, 80) %>...
                        </p>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } else { %>
        <div class="text-center p-10 bg-gray-50 rounded-lg shadow-inner">
            <p class="text-lg text-gray-600">
                Nenhuma praia encontrada. Que tal <a href="/praias/nova" class="text-blue-600 hover:underline font-medium">cadastrar a primeira</a>?
            </p>
        </div>
    <% } %>

</div>