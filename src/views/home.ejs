<main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

    <h1 class="text-4xl font-extrabold text-gray-900 mb-2">Descubra as Melhores Praias</h1>
    <p class="text-xl text-gray-600 mb-8">Encontre o seu próximo destino de areia e mar!</p>

    <!-- MENSAGENS -->
    <% if (successMessage) { %>
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded-lg mb-6" role="alert">
            <p class="font-bold">Sucesso!</p>
            <p class="text-sm"><%= successMessage %></p>
        </div>
    <% } %>

    <% if (errorMessage) { %>
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-lg mb-6" role="alert">
            <p class="font-bold">Erro!</p>
            <p class="text-sm"><%= errorMessage %></p>
        </div>
    <% } %>

    <!-- FILTRO -->
    <div class="bg-white p-6 rounded-xl shadow-lg mb-10">
        <h3 class="text-lg font-semibold text-gray-800 mb-4">Filtrar Praias</h3>

        <form method="GET" class="space-y-4 md:space-y-0 md:flex md:space-x-4">

            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="flex-1">
                <input type="text" id="cidade" name="cidade"
                placeholder="Buscar por Cidade"
                value="<%= query.cidade || '' %>"
                class="mt-1 block w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:ring-blue-500">
            </div>

            <div class="flex-1">
                <input type="text" id="estado" name="estado"
                placeholder="Buscar por Estado (UF)"
                value="<%= query.estado || '' %>"
                class="mt-1 block w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:ring-blue-500">
            </div>

            <button type="submit"
                class="w-full md:w-auto px-4 py-2 bg-blue-600 text-white rounded-lg font-semibold hover:bg-blue-700 shadow-md transition">
                Buscar
            </button>

            <a href="/praias"
                class="w-full md:w-auto px-4 py-2 text-center border border-gray-300 text-gray-700 rounded-lg font-semibold hover:bg-gray-100 shadow-md transition">
                Limpar
            </a>
        </form>
    </div>

    <!-- LISTA DE PRAIAS -->
    <% if (!praias || praias.length === 0) { %>

        <div class="text-center py-10 bg-white rounded-xl shadow-lg">
            <p class="text-xl text-gray-500">Nenhuma praia encontrada com os filtros aplicados.</p>
        </div>

    <% } else { %>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">

            <% praias.forEach(praia => { %>

                <div class="bg-white rounded-xl shadow-xl overflow-hidden hover:shadow-2xl transition transform hover:-translate-y-1">

                    <div class="h-48 bg-gray-200">
                        <img src="<%= praia.foto_url || 'https://placehold.co/600x400/005a9c/ffffff?text=Praia+Sem+Foto' %>"
                        alt="Foto da praia <%= praia.nome %>"
                        onerror="this.onerror=null;this.src='https://placehold.co/600x400/005a9c/ffffff?text=Praia+Sem+Foto';"
                        class="w-full h-full object-cover">
                    </div>

                    <div class="p-5">
                        <h2 class="text-xl font-bold text-gray-900 mb-2 truncate">
                            <%= praia.nome %>
                        </h2>

                        <p class="text-sm text-gray-500 mb-3">
                            <%= praia.cidade %> - <%= praia.estado %>
                        </p>

                        <div class="flex items-center justify-between mb-4">
                            <div class="flex items-center gap-2">
                                <span class="text-3xl font-extrabold text-yellow-500">
                                    <%= praia.media_avaliacao ?? 0 %>
                                </span>

                                <svg xmlns="http://www.w3.org/2000/svg"
                                     class="h-6 w-6 text-yellow-500"
                                     viewBox="0 0 20 20" fill="currentColor">
                                    <path d="M9.049 2.927c.3-.921 1.635-.921 1.935 0l1.24 3.803a1 1 0 
                                    00.95.69h4.004c.969 0 1.371 1.24.588 1.838l-3.23 
                                    2.345a1 1 0 00-.364 1.118l1.24 3.803c.3.921-.755 
                                    1.688-1.54 1.118l-3.23-2.345a1 1 0 00-1.175 
                                    0l-3.23 2.345c-.785.57-1.84-.197-1.54-1.118l1.24-
                                    3.803a1 1 0 00-.364-1.118L2.245 9.258c-.783-.598-.381-
                                    1.838.588-1.838h4.004a1 1 0 00.95-.69l1.24-3.803z"/>
                                </svg>
                            </div>

                            <span class="text-sm text-gray-600">
                                (<%= praia.total_avaliacoes ?? 0 %> avaliações)
                            </span>
                        </div>

                        <a href="/praias/<%= praia.id_praia %>"
                        class="block w-full text-center py-2 px-4 rounded-lg shadow-sm text-white bg-blue-600 hover:bg-blue-700 transition">
                            Ver Detalhes
                        </a>

                    </div>
                </div>

            <% }) %>
        </div>

    <% } %>

</main>
