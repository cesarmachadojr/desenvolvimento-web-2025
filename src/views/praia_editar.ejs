<!-- src/views/praia_editar.ejs -->

<div class="container mx-auto max-w-3xl mt-10 bg-white p-6 rounded-xl shadow">

    <h1 class="text-3xl font-bold mb-6">Editar Praia</h1>

    <form action="/praias/<%= praia.id %>/editar" method="POST" class="space-y-6">

        <div>
            <label class="font-semibold">Nome da Praia</label>
            <input 
                type="text" 
                name="nome"
                value="<%= praia.nome %>"
                required
                class="w-full p-2 border rounded-lg"
            >
        </div>

        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="font-semibold">UF</label>
                <input 
                    type="text"
                    name="uf"
                    maxlength="2"
                    value="<%= praia.uf %>"
                    required
                    class="w-full p-2 border rounded-lg"
                >
            </div>

            <div>
                <label class="font-semibold">Cidade</label>
                <input 
                    type="text"
                    name="cidade"
                    value="<%= praia.cidade %>"
                    required
                    class="w-full p-2 border rounded-lg"
                >
            </div>
        </div>

        <div>
            <label class="font-semibold">Descrição</label>
            <textarea 
                name="descricao" 
                rows="4"
                class="w-full p-2 border rounded-lg"
            ><%= praia.descricao %></textarea>
        </div>

        <div>
            <label class="font-semibold">Nota (0-10)</label>
            <input 
                type="number"
                name="nota"
                min="0"
                max="10"
                value="<%= praia.nota %>"
                required
                class="w-full p-2 border rounded-lg"
            >
        </div>

        <div>
            <label class="font-semibold">URL da Imagem</label>
            <input 
                type="url"
                name="imagem_url"
                value="<%= praia.imagem_url %>"
                class="w-full p-2 border rounded-lg"
            >
        </div>

        <button
            class="w-full bg-blue-600 text-white p-3 rounded-lg hover:bg-blue-800 transition">
            Salvar Alterações
        </button>

        <a 
            href="/praias/<%= praia.id %>"
            class="block text-center mt-4 text-gray-700 hover:underline">
            Cancelar
        </a>

    </form>
</div>
