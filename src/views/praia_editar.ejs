<div class="container mx-auto max-w-3xl mt-10 bg-white p-6 rounded-xl shadow">

    <h1 class="text-3xl font-bold mb-6">Editar Praia</h1>

    <form action="/praias/<%= praia.id_praia %>/editar" method="POST" class="space-y-6">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div>
            <label class="font-semibold">Nome da Praia</label>
            <input 
                type="text" 
                name="nome"
                value="<%= praia.nome %>"
                required
                class="w-full p-2 border rounded-lg"
            >
        </div>

        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="font-semibold">Estado (UF)</label>
                <input 
                    type="text"
                    name="estado"
                    maxlength="2"
                    value="<%= praia.estado %>"
                    required
                    class="w-full p-2 border rounded-lg"
                >
            </div>

            <div>
                <label class="font-semibold">Cidade</label>
                <input 
                    type="text"
                    name="cidade"
                    value="<%= praia.cidade %>"
                    required
                    class="w-full p-2 border rounded-lg"
                >
            </div>
        </div>

        <div>
            <label class="font-semibold">Descrição</label>
            <textarea 
                name="descricao" 
                rows="4"
                class="w-full p-2 border rounded-lg"
            ><%= praia.descricao %></textarea>
        </div>

        <div>
            <label class="font-semibold">URL da Imagem</label>
            <input 
                type="url"
                name="foto_url"
                value="<%= praia.foto_url %>"
                class="w-full p-2 border rounded-lg"
            >
        </div>

        <div>
            <label class="font-semibold">Categorias</label>
            <select name="categorias" multiple class="w-full p-2 border rounded-lg">
                <% categorias.forEach(cat => { %>
                    <option value="<%= cat.id_categoria %>" 
                        <%= categoriasSelecionadas.includes(cat.id_categoria) ? "selected" : "" %>>
                        <%= cat.nome %>
                    </option>
                <% }) %>
            </select>
        </div>

        <button
            type="submit"
            class="w-full bg-blue-600 text-white p-3 rounded-lg hover:bg-blue-800 transition">
            Salvar Alterações
        </button>
    </form>

    <form 
        action="/praias/<%= praia.id_praia %>/deletar" 
        method="POST" 
        class="mt-4"
        onsubmit="return confirm('Tem certeza que deseja excluir esta praia? Esta ação não pode ser desfeita.');"
    >
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        
        <button
            type="submit"
            class="w-full bg-red-600 text-white p-3 rounded-lg hover:bg-red-800 transition">
            Excluir Praia
        </button>
    </form>

    <a 
        href="/praias/<%= praia.id_praia %>"
        class="block text-center mt-4 text-gray-700 hover:underline">
        Cancelar
    </a>

</div>