<!-- HEADER -->
<%- include('../layouts/partials/header') %>

<main class="flex-grow max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

    <h1 class="text-3xl font-bold text-gray-900 mb-6">Gerenciar Praias</h1>

    <!-- MENSAGENS -->
    <% if (successMessage) { %>
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded-lg mb-6">
            <p class="font-bold">Sucesso!</p>
            <p class="text-sm"><%= successMessage %></p>
        </div>
    <% } %>

    <% if (errorMessage) { %>
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-lg mb-6">
            <p class="font-bold">Erro!</p>
            <p class="text-sm"><%= errorMessage %></p>
        </div>
    <% } %>

    <!-- BOTÃO CRIAR PRAIA -->
    <div class="mb-6">
        <a href="/praias/criar"
           class="inline-block px-5 py-2 bg-blue-600 text-white font-semibold rounded-lg shadow hover:bg-blue-700 transition">
            + Cadastrar Nova Praia
        </a>
    </div>

    <!-- TABELA -->
    <div class="bg-white shadow-lg rounded-xl overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-100">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-600 uppercase">ID</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-600 uppercase">Nome</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-600 uppercase">Cidade</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-600 uppercase">Estado</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-600 uppercase">Ações</th>
                </tr>
            </thead>

            <tbody class="divide-y divide-gray-200">
                <% praias.forEach(praia => { %>

                    <tr>
                        <td class="px-6 py-4 text-sm text-gray-700"><%= praia.id_praia %></td>
                        <td class="px-6 py-4 text-sm font-medium text-gray-900"><%= praia.nome %></td>
                        <td class="px-6 py-4 text-sm text-gray-700"><%= praia.cidade %></td>
                        <td class="px-6 py-4 text-sm text-gray-700"><%= praia.estado %></td>

                        <td class="px-6 py-4 flex space-x-3">

                            <a href="/praias/<%= praia.id_praia %>/editar"
                               class="px-3 py-1 bg-yellow-500 text-white text-sm rounded-lg hover:bg-yellow-600 transition">
                                Editar
                            </a>

                            <form action="/praias/<%= praia.id_praia %>?_method=DELETE" method="POST"
                                  onsubmit="return confirm('Tem certeza que deseja excluir esta praia?')">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button class="px-3 py-1 bg-red-600 text-white text-sm rounded-lg hover:bg-red-700 transition">
                                    Excluir
                                </button>
                            </form>

                        </td>
                    </tr>

                <% }) %>
            </tbody>

        </table>
    </div>

</main>

<!-- FOOTER -->
<%- include('../layouts/partials/footer') %>
