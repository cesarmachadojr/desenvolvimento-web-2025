<%- include("../../partials/header", { title }) %>

<div class="container mt-4">

    <!-- Título -->
    <h2 class="mb-4 text-primary fw-bold">
        ✏️ Editar Praia – <%= praia.nome %>
    </h2>

    <!-- Mensagens de sucesso / erro -->
    <% if (successMessage) { %>
        <div class="alert alert-success"><%= successMessage %></div>
    <% } %>

    <% if (errorMessage) { %>
        <div class="alert alert-danger"><%= errorMessage %></div>
    <% } %>

    <!-- FORMULÁRIO -->
    <form action="/api/praias/<%= praia.id_praia %>?_method=PUT" method="POST">

        <!-- Nome -->
        <div class="mb-3">
            <label class="form-label fw-bold">Nome da praia</label>
            <input 
                type="text" 
                name="nome" 
                value="<%= praia.nome %>" 
                class="form-control" 
                required
            >
        </div>

        <!-- Cidade -->
        <div class="mb-3">
            <label class="form-label fw-bold">Cidade</label>
            <input 
                type="text" 
                name="cidade" 
                value="<%= praia.cidade %>" 
                class="form-control" 
                required
            >
        </div>

        <!-- Estado -->
        <div class="mb-3">
            <label class="form-label fw-bold">Estado</label>
            <input 
                type="text" 
                name="estado" 
                maxlength="2" 
                value="<%= praia.estado %>" 
                class="form-control" 
                required
            >
        </div>

        <!-- Foto -->
        <div class="mb-3">
            <label class="form-label fw-bold">URL da foto</label>
            <input 
                type="text" 
                name="foto_url" 
                value="<%= praia.foto_url || "" %>" 
                class="form-control"
            >
        </div>

        <!-- Descrição -->
        <div class="mb-3">
            <label class="form-label fw-bold">Descrição</label>
            <textarea 
                name="descricao" 
                class="form-control"
                rows="4"
            ><%= praia.descricao || "" %></textarea>
        </div>

        <!-- Botões -->
        <div class="mt-4 d-flex justify-content-between">

            <a href="/praias/<%= praia.id_praia %>" class="btn btn-secondary">
                Voltar
            </a>

            <button type="submit" class="btn btn-primary px-4 fw-bold">
                Salvar Alterações ✔
            </button>

        </div>

    </form>

</div>

<%- include("../../partials/footer") %>
