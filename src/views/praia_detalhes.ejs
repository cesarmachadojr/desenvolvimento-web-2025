<!-- src/views/praia_detalhes.ejs -->

<div class="container mx-auto mt-10 max-w-3xl bg-white p-6 rounded-xl shadow">

    <h1 class="text-3xl font-bold mb-6"><%= praia.nome %></h1>

    <div class="space-y-4">

        <p>
            <strong>Estado (UF):</strong> <%= praia.estado %>
        </p>

        <p>
            <strong>Cidade:</strong> <%= praia.cidade %>
        </p>

        <p>
            <strong>Descrição:</strong><br>
            <%= praia.descricao %>
        </p>

        <% if (praia.nota) { %>
        <p>
            <strong>Nota:</strong> <%= praia.nota %> / 10
        </p>
        <% } %>

        <% if (praia.foto_url) { %>
            <img 
                src="<%= praia.foto_url %>" 
                alt="Imagem da praia" 
                class="mt-4 w-full rounded-lg shadow"
            >
        <% } %>

    </div>

    <div class="mt-8 flex">

        <a href="/praias" 
            class="px-4 py-2 bg-gray-700 text-white rounded-lg hover:bg-gray-900 transition">
            Voltar
        </a>

    </div>

</div>
